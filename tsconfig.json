{
  "include": ["src/**/*", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "src/__tests__/**"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "bundles-out",
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2015",
    "lib": ["ES2015", "DOM"],
    "types": ["node"],
    "jsx": "preserve",
    "allowJs": false,
    "checkJs": false,
    "importHelpers": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "incremental": false,
    "strictNullChecks": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "alwaysStrict": true,
    "noImplicitAny": true,
    "noImplicitThis": true
  }
}
