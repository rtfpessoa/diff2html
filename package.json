{
  "name": "diff2html",
  "version": "3.0.0-beta.1",
  "homepage": "https://diff2html.xyz",
  "description": "Fast Diff to colorized HTML",
  "keywords": [
    "git",
    "diff",
    "pretty",
    "side",
    "line",
    "side-by-side",
    "line-by-line",
    "character",
    "highlight",
    "pretty",
    "color",
    "html",
    "diff2html",
    "difftohtml",
    "colorized"
  ],
  "author": {
    "name": "Rodrigo Fernandes",
    "email": "rtfrodrigo@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rtfpessoa/diff2html.git"
  },
  "bugs": {
    "url": "https://www.github.com/rtfpessoa/diff2html/issues"
  },
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "lint:staged": "lint-staged",
    "lint:check": "eslint",
    "lint:fix": "eslint --fix",
    "prettier": "prettier --ignore-path .gitignore '**/*.+(js|jsx|mjs|ts|tsx|mts|json|css|html|md|mdx)'",
    "format:check": "npm run prettier -- --check",
    "format:fix": "npm run prettier -- --write",
    "build": "npm run build:css && npm run build:templates && npm run build:commonjs && npm run build:esm && npm run build:bundles && npm run build:website",
    "build:commonjs": "rm -rf lib && tsc -p tsconfig.json --rootDir src --outDir lib",
    "build:esm": "rm -rf lib-esm && tsc -p tsconfig.esm.json --rootDir src --outDir lib-esm",
    "build:bundles": "rm -rf ./bundles/js; webpack --mode production --config webpack.bundles.mts",
    "build:css": "rm -rf ./bundles/css; postcss --config ./postcss.config.js --no-map -o ./bundles/css/diff2html.min.css ./src/ui/css/diff2html.css",
    "build:templates": "ts-node ./scripts/hulk.ts --wrapper ts --variable 'defaultTemplates' ./src/templates/*.mustache > ./src/diff2html-templates.ts",
    "build:website": "rm -rf docs; webpack --mode production --config webpack.website.mts",
    "gen": "npm run gen:toc",
    "gen:toc-base": "node scripts/update-readme-toc.mjs",
    "gen:toc": "npm run gen:toc-base -- README.md",
    "test": "is-ci 'test:coverage' 'test:watch'",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --watch",
    "coverage:open": "npm run test:coverage && open ./coverage/index.html",
    "coverage:push": "curl -Ls https://coverage.codacy.com/get.sh | bash",
    "validate": "npm run build:templates && npm run format:check && npm run lint:check && node --test scripts/update-readme-toc-checks.mjs && npm run build && npm run test:coverage",
    "fix": "npm run format:fix && npm run lint:fix",
    "start": "npm run start:website",
    "start:website": "webpack serve --mode development --config webpack.website.mts",
    "preversion": "npm run validate",
    "version": "git add -A package.json",
    "prepare": "husky"
  },
  "main": "./lib/diff2html.js",
  "module": "./lib-esm/diff2html.js",
  "types": "./lib/diff2html.d.ts",
  "lint-staged": {
    "**/*.+(js|jsx|mjs|ts|tsx|mts|json)": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.+(css|html|mdx)": [
      "prettier --write"
    ],
    "**/!(README).md": [
      "prettier --write"
    ],
    "*/**/README.md": [
      "prettier --write"
    ],
    "./README.md": [
      "npm run gen:toc-base --",
      "prettier --write"
    ]
  },
  "dependencies": {
    "diff": "^8.0.3",
    "@profoundlogic/hogan": "^3.0.4"
  },
  "optionalDependencies": {
    "highlight.js": "11.11.1"
  },
  "devDependencies": {
    "@all-contributors/cli": "7.1.0",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@types/hogan.js": "3.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.11",
    "@types/nopt": "3.0.32",
    "autoprefixer": "10.7.0",
    "bulma": "^1.0.4",
    "clipboard": "2.0.11",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "cssnano": "9.9.0",
    "eslint": "10.16.0",
    "eslint-plugin-jest": "29.17.2",
    "eslint-plugin-promise": "7.3.0",
    "github-slugger": "2.0.0",
    "globals": "17.14.0",
    "handlebars": "4.7.10",
    "handlebars-loader": "1.7.3",
    "html-webpack-plugin": "5.6.8",
    "husky": "^9.1.7",
    "is-ci-cli": "2.2.0",
    "jest": "30.5.2",
    "lint-staged": "17.6.2",
    "markdown-it": "15.0.3",
    "mini-css-extract-plugin": "2.10.2",
    "mkdirp": "3.0.1",
    "nopt": "10.0.1",
    "postcss": "8.5.34",
    "postcss-cli": "12.0.0",
    "postcss-import": "17.0.1",
    "postcss-loader": "8.2.2",
    "postcss-preset-env": "11.6.3",
    "prettier": "3.10.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "webpack": "5.113.0",
    "webpack-cli": "7.3.1",
    "webpack-dev-server": "6.1.0",
    "whatwg-fetch": "3.6.20"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "fsevents": false
  },
  "license": "MIT",
  "files": [
    "bundles",
    "lib",
    "lib-esm",
    "typings"
  ]
}
